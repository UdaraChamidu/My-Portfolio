OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Server-side chat protection. UTC daily windows; no n8n required.
CHAT_DAILY_LIMIT=50
CHAT_MINUTE_LIMIT=5
CHAT_GLOBAL_DAILY_LIMIT=200
# Required for Vercel/production; put real values only in private settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional separate hashing secret; falls back to OPENAI_API_KEY.
CHAT_RATE_LIMIT_SECRET=
ARTICLE_API_KEY=replace_with_a_long_random_secret
PUBLIC_SITE_URL=https://your-domain.com
# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
